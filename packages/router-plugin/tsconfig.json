{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "target": "es2015",
    "module": "CommonJS",
    "experimentalDecorators": false,
    "outDir": "dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "removeComments": true,
    "downlevelIteration": true,
    "sourceMap": true,
    "isolatedModules": false,
    "noEmit": false
  },
  "include": ["./**/*.ts", "./**/*.tsx", "index.ts"],
  "exclude": ["node_modules", "dist"]
}
